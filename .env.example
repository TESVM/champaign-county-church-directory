# Champaign County Church Directory — environment variables
# Copy to .env.local for development. Never commit real values.
# Production boot fails with a clear message if a REQUIRED value is missing.

# --- Core (REQUIRED in production) ------------------------------------------
# Postgres connection string. Use a pooled URL on serverless hosting
# (e.g. Neon/Supabase pooler, add ?pgbouncer=true&connection_limit=1).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Keys the one-way hashes used for rate limiting and activity de-duplication. 32+ random chars.
# Generate: openssl rand -base64 48
AUTH_SECRET=""
# Canonical public origin. Used in emailed sign-in links, canonical URLs, sitemap.
SITE_URL="https://your-domain.example"
# This address becomes the first administrator the first time it signs in
# with an emailed link. Use a mailbox you control.
ADMIN_EMAIL=""
# Shared secret for the weekly website-review cron (Vercel sends it automatically
# as "Authorization: Bearer <CRON_SECRET>"). 16+ random chars.
CRON_SECRET=""

# --- Email (REQUIRED in production) -------------------------------------------
# "resend" delivers mail. "log" only records it in the Email log (development).
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, e.g. "Church Directory <hello@your-domain.example>"
EMAIL_FROM=""
# Where claim/submission/correction notifications go (defaults to ADMIN_EMAIL).
ADMIN_NOTIFY_EMAIL=""
# Public support address shown in the footer, contact page and replies. Leave
# blank until a real, monitored mailbox exists; the site then shows the contact form only.
SUPPORT_EMAIL=""
# Local production testing only: lets `next start` run with EMAIL_PROVIDER=log.
# Never set on a public deployment.
ALLOW_LOG_EMAIL="false"

# --- Billing: Enhanced Church Profile, $29/month (optional until launch) ------
# From the Stripe dashboard (use sk_test_/whsec_ test values first).
STRIPE_SECRET_KEY=""
# Recurring monthly Price of $29.00 USD.
STRIPE_PRICE_ID=""
# Signing secret of the webhook endpoint https://YOUR-DOMAIN/api/billing/webhook
STRIPE_WEBHOOK_SECRET=""

# --- Photo uploads (optional; without it, church photos can be linked by URL) -
# "local" writes to public/uploads (development only). Production needs "blob".
MEDIA_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# --- Optional -----------------------------------------------------------------
# Bootstrap administrator password sign-in (emailed links are preferred).
# 12+ characters. Leave blank to disable password sign-in entirely.
ADMIN_PASSWORD=""
# Weekly website review: identify the bot honestly; set a contact URL.
SCAN_USER_AGENT="ChampaignCountyChurchDirectoryBot/1.0 (+https://your-domain.example/about)"
# Websites checked per weekly run (1-200).
SCAN_BATCH_SIZE="25"
# Search indexing: on Vercel only the production environment is indexable.
# Elsewhere set ALLOW_INDEXING="true" on the live site only.
ALLOW_INDEXING="false"
# Companion musician directory link.
NEXT_PUBLIC_MUSICIAN_DIRECTORY_URL="https://central-illinois-music-directory.vercel.app"

# AI church images are OFF. Generated buildings are never shown as a church's
# photo. Leave false unless the owner decides otherwise.
AI_IMAGES_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL=""
