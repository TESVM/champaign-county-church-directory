DATABASE_URL="postgresql://postgres:postgres@localhost:5432/champaign_church_directory"
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3004"
NEXTAUTH_URL="http://localhost:3004"
NEXT_PUBLIC_CHURCH_DIRECTORY_URL="http://localhost:3004"
NEXT_PUBLIC_MUSICIAN_DIRECTORY_URL="http://localhost:3005"
# In production, set these to your live domains or Vercel URLs.
MAPBOX_EMBED_STYLE="streets-v12"
MAPBOX_TOKEN=""
CRON_SECRET="replace-with-cron-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
SCAN_USER_AGENT="ChampaignCountyChurchDirectoryBot/1.0 (+https://example.com)"

# --- AI church images (optional) -------------------------------------------
# Admins and church owners can generate an HD image for a church with no
# uploaded photo. Generated images are labelled "AI-generated image". Keep the
# key server-side only; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# "local" writes to public/uploads (development only). Production needs "blob".
MEDIA_DRIVER=local
BLOB_READ_WRITE_TOKEN=
